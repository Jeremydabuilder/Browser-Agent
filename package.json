{
  "name": "satchel-browser-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Satchel: a Manifest V3 side-panel assistant for Chrome and Edge with a Windows companion for Groq.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:companion": "node --test \"tests/companion/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "test:all": "npm test && npm run test:companion && npm run test:e2e",
    "lint": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:e2e:dist": "node tests/e2e/run-e2e.mjs --from-dist"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.1"
  }
}
